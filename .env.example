# Copy to .env to override defaults (docker compose reads it automatically).
POSTGRES_PASSWORD=loadguard
# auto | classical | yolo | yoloworld | hybrid | groundtruth
LG_DETECTOR=auto
# false = slim image, classical OpenCV detector only
INSTALL_YOLO=true
LG_SEED_DEMO=true

# --- Public deployment (docker-compose.prod.yml) ---
# Domain pointing at your server. No domain? Use <name>.<ip-with-dashes>.sslip.io
DOMAIN=loadguard.203-0-113-7.sslip.io
# true = trailers can't be added, edited or deleted (the app has no login yet)
LG_DEMO_MODE=true
